"""
MODULE.bazel — Bzlmod (Bazel 6+) dependency manifest.
Replaces the legacy WORKSPACE.bazel file.
"""

module(
    name = "foobar",
    version = "1.0.0",
)

# ── Core ──────────────────────────────────────────────────────────────────────
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# ── Go ────────────────────────────────────────────────────────────────────────
bazel_dep(name = "rules_go", version = "0.49.0")
bazel_dep(name = "gazelle", version = "0.37.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.0")

# Resolve Go module deps declared in go/go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//go:go.mod")

use_repo(
    go_deps,
    "com_github_fatih_color",
    "com_github_mattn_go_colorable",
    "com_github_mattn_go_isatty",
)

# ── Rust ──────────────────────────────────────────────────────────────────────
bazel_dep(name = "rules_rust", version = "0.48.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021")

# Use from_specs so no Cargo.lock is required at the workspace root
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "colored",
    version = "2.1",
)
crate.from_specs(name = "crates")

use_repo(crate, "crates")

# ── Python ────────────────────────────────────────────────────────────────────
bazel_dep(name = "rules_python", version = "0.37.2")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_deps",
    python_version = "3.12",
    requirements_lock = "//python:requirements.txt",
)

use_repo(pip, "pip_deps")

# ── Node / npm ────────────────────────────────────────────────────────────────
bazel_dep(name = "aspect_rules_js", version = "1.42.3")
bazel_dep(name = "rules_nodejs", version = "6.3.0")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.13.1")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//js:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)

use_repo(npm, "npm")
