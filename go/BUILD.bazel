load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "foobar_lib",
    srcs = ["main.go"],
    importpath = "foobar",
    visibility = ["//visibility:private"],
    deps = ["@com_github_fatih_color//:color"],
)

go_binary(
    name = "foobar",
    embed = [":foobar_lib"],
    visibility = ["//visibility:public"],
    data = [
        "//rust:foo",
        "//js:bar",
        "//python:foobar_py",
    ],
)
